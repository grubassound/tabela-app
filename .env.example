# Skopiuj ten plik jako .env i uzupełnij prawdziwymi danymi. Plik .env NIE trafia do gita.

# Połączenie z bazą MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=tabela_user
DB_PASSWORD=wpisz-tu-prawdziwe-haslo
DB_NAME=tabela_app

# Losowy, długi ciąg znaków — sekret do podpisywania sesji logowania
SESSION_SECRET=wygeneruj-losowy-dlugi-ciag-znakow

# Port, na którym nasłuchuje aplikacja Node.js
PORT=3001
