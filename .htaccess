Options -Indexes

# Blokada ukrytych plików i katalogów (.git, .env, .htaccess itp.)
RedirectMatch 404 "(^|/)\."

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    Header always unset X-Powered-By
</IfModule>

<Files "config.php">
    Require all denied
</Files>

<Files "config.php.example">
    Require all denied
</Files>

<FilesMatch "\.(sql|log|md)$">
    Require all denied
</FilesMatch>
